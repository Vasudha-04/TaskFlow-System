# Frontend Environment Variables for TaskFlow
# =============================================

# VITE_API_URL is OPTIONAL.
# 
# If NOT set (recommended for development):
#   Axios will call "/api" which gets proxied by Vite to the backend.
#   This avoids CORS issues entirely.
#
# If SET (for production or when NOT using Vite proxy):
#   Axios will call this URL directly.
#   Example: VITE_API_URL=http://127.0.0.1:5000/api
#
# VITE_API_URL=http://127.0.0.1:5000/api

